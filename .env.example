# AnotaGym — Variables de entorno necesarias
# Copia este archivo como .env.local y rellena los valores
# con los datos de tu proyecto Firebase.
#
# 🔗 Consola Firebase: https://console.firebase.google.com
#    → Tu proyecto → Configuración → Tus apps → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
